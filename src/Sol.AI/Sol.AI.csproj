<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sol.AI</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Browser.Core/SolAiProfiles.cs" Link="SolAiProfiles.cs" />
    <Compile Include="../Browser.Core/SolAiText.cs" Link="SolAiText.cs" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.1.0" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ai.foundry.local/2.1.0/LICENSE.txt" Link="licenses/Foundry-SDK.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ai.foundry.local.runtime/2.1.0/LICENSE.txt" Link="licenses/Foundry-runtime.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ai.foundry.local.runtime/2.1.0/Privacy.md" Link="licenses/Foundry-privacy.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ai.foundry.local.runtime/2.1.0/ThirdPartyNotices.txt" Link="licenses/Foundry-third-party.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ml.onnxruntime/1.30.0/LICENSE" Link="licenses/ONNX-Runtime.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ml.onnxruntime/1.30.0/ThirdPartyNotices.txt" Link="licenses/ONNX-third-party.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ml.onnxruntimegenai.foundry/0.17.1/LICENSE" Link="licenses/ONNX-GenAI.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.ml.onnxruntimegenai.foundry/0.17.1/ThirdPartyNotices.txt" Link="licenses/ONNX-GenAI-third-party.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
