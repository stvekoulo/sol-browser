<Window x:Class="Browser.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Browser.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <WebView2 x:Name="Ui" Grid.Row="0" />
    <Grid x:Name="Pages" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
        <ColumnDefinition x:Name="DividerColumn" Width="0" />
        <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <local:DividerGrip x:Name="Divider" Grid.Column="1" Background="#40808080" />
    </Grid>
    <!-- Vue posée par-dessus la page : suggestions, bibliothèque. Déclarée en dernier, donc dessinée au-dessus. -->
    <Grid x:Name="PopupFrame" Grid.RowSpan="2" Width="1" Height="1"
          HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12"
          BorderThickness="1" BorderBrush="#33808080">
      <WebView2 x:Name="Popup" />
    </Grid>
  </Grid>
</Window>
