<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Browser.App</RootNamespace>
    <AssemblyName>Sol</AssemblyName>
    <Product>Sol</Product>
    <AssemblyTitle>Sol browser</AssemblyTitle>
    <ApplicationIcon>Assets\Sol.ico</ApplicationIcon>
    <Platforms>x64;x86;ARM64</Platforms>
    <!-- 64 bits par défaut ; tools/publish.ps1 produit aussi ARM64 et 32 bits. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <UseWinUI>true</UseWinUI>
    <!-- Point d'entrée écrit à la main (Program.cs) : l'installateur doit pouvoir agir avant l'interface. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>1.0.19</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\Browser.Core\Browser.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Interface React compilée (npm run build dans ui/) -->
    <Content Include="inject\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ui\node_modules\@mozilla\readability\Readability.js" Link="inject\Readability.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ui\node_modules\@mozilla\readability\LICENSE.md" Link="inject\Readability-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Sol.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="extensions\**" Exclude="extensions\ubol\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ui\dist\**" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
