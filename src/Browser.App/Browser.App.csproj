<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Browser.App</RootNamespace>
    <AssemblyName>Navigateur</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />
    <ProjectReference Include="..\Browser.Core\Browser.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Interface React compilée (npm run build dans ui/) -->
    <Content Include="inject\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- uBlock Origin Lite, récupéré par tools/get-ublock.ps1 (absent : le navigateur garde son blocage par domaines) -->
    <Content Include="extensions\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ui\dist\**" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
